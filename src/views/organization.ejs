<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2><%= organization.name %></h2>
    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
    <p><%= organization.description %></p>

    <h3>Service Projects</h3>
    <% if (projects.length > 0) { %>
        <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a>
                <p><%= project.description %></p>
            </li>
        <% }) %>
        </ul>
    <% } else { %>
        <p>No service projects found for this organization.</p>
    <% } %>

    <p><a href="/organizations">Back to Organizations</a></p>
</main>
<%- include('partials/footer') %>
