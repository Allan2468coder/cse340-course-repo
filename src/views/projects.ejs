<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <% if (currentUser && currentUser.account_type === 'Admin') { %>
        <p><a href="/new-project">Create New Service Project</a></p>
    <% } %>
    <ul>
    <% projects.forEach(project => { %>
        <li>
            <%= new Date(project.date || project.project_date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            }) %>:
            <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a>
            by <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
            <% if (currentUser && currentUser.account_type === 'Admin') { %>
                <a href="/edit-project/<%= project.project_id %>">Edit</a>
            <% } %>
        </li>
    <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>
