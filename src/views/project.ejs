<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2><%= project.title %></h2>
    <% if (currentUser && currentUser.account_type === 'Admin') { %>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Service Project</a></p>
    <% } %>
    <p><strong>Date:</strong> <%= new Date(project.date || project.project_date).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    }) %></p>
    <p><strong>Location:</strong> <%= project.location || 'Not specified' %></p>
    <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    <p><strong>Description:</strong> <%= project.description %></p>

    <% if (currentUser) { %>
        <% if (isVolunteer) { %>
            <p>You are volunteering for this project.</p>
            <form action="/project/<%= project.project_id %>/unvolunteer" method="post">
                <button type="submit">Remove me as a volunteer</button>
            </form>
        <% } else { %>
            <form action="/project/<%= project.project_id %>/volunteer" method="post">
                <button type="submit">Volunteer for this project</button>
            </form>
        <% } %>
    <% } %>

    <h3>Categories</h3>
    <p><a href="/assign-categories/<%= project.project_id %>">Update Project Categories</a></p>
    <% if (categories && categories.length > 0) { %>
        <ul>
        <% categories.forEach(category => { %>
            <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
        <% }) %>
        </ul>
    <% } else { %>
        <p>No categories assigned to this project.</p>
    <% } %>

    <p><a href="/projects">Back to Projects</a></p>
</main>
<%- include('partials/footer') %>
