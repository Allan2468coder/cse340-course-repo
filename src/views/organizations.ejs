<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>Here are a few of our partner organizations:</p>
    <% if (currentUser && currentUser.account_type === 'Admin') { %>
        <p><a href="/new-organization">Create New Organization</a></p>
    <% } %>
    <ul>
    <% organizations.forEach(organization => { %>
        <li>
            <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
            <a href="/organization/<%= organization.organization_id %>"><strong><%= organization.name %></strong></a>: <%= organization.description %>
            Contact: <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a>
            <% if (currentUser && currentUser.account_type === 'Admin') { %>
                <a href="/edit-organization/<%= organization.organization_id %>">Edit</a>
            <% } %>
        </li>
    <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>
